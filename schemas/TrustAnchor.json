{
  "$id": "https://aegisops.invalid/schemas/v1/TrustAnchor.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "key_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Key Id",
      "type": "string"
    },
    "public_key": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Public Key",
      "type": "string"
    }
  },
  "required": [
    "public_key",
    "key_id"
  ],
  "title": "TrustAnchor",
  "type": "object"
}
