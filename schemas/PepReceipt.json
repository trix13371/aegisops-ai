{
  "$defs": {
    "AuthorizationControl": {
      "additionalProperties": false,
      "properties": {
        "blocked_actions": {
          "default": [],
          "items": {
            "enum": [
              "escalate_to_human",
              "collect_more_evidence",
              "restart_workload",
              "rollback_deployment"
            ],
            "type": "string"
          },
          "maxItems": 4,
          "title": "Blocked Actions",
          "type": "array"
        },
        "blocked_clusters": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Blocked Clusters",
          "type": "array"
        },
        "generation": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Generation",
          "type": "integer"
        },
        "global_blocked": {
          "title": "Global Blocked",
          "type": "boolean"
        }
      },
      "required": [
        "generation",
        "global_blocked"
      ],
      "title": "AuthorizationControl",
      "type": "object"
    },
    "OpaInput": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Action Id",
          "type": "string"
        },
        "autonomy_level": {
          "const": "L0",
          "default": "L0",
          "title": "Autonomy Level",
          "type": "string"
        },
        "bundle_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Bundle Hash",
          "type": "string"
        },
        "catalog_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Catalog Hash",
          "type": "string"
        },
        "cluster_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Cluster Id",
          "type": "string"
        },
        "execution_performed": {
          "const": false,
          "default": false,
          "title": "Execution Performed",
          "type": "boolean"
        },
        "incident_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Incident Id",
          "type": "string"
        },
        "input_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "namespace": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        },
        "owner_kinds": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "title": "Owner Kinds",
          "type": "array"
        },
        "params": {
          "additionalProperties": {
            "anyOf": [
              {
                "maxLength": 512,
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "maxProperties": 16,
          "title": "Params",
          "type": "object"
        },
        "policy_version": {
          "const": "opa-l0-1",
          "default": "opa-l0-1",
          "title": "Policy Version",
          "type": "string"
        },
        "recommendation_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Recommendation Id",
          "type": "string"
        },
        "recommendation_incident_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Recommendation Incident Id",
          "type": "string"
        },
        "requires_human_approval": {
          "const": true,
          "default": true,
          "title": "Requires Human Approval",
          "type": "boolean"
        },
        "reversibility": {
          "enum": [
            "R1",
            "R2",
            "R3"
          ],
          "title": "Reversibility",
          "type": "string"
        },
        "workload": {
          "maxLength": 253,
          "minLength": 1,
          "title": "Workload",
          "type": "string"
        }
      },
      "required": [
        "bundle_hash",
        "catalog_hash",
        "input_hash",
        "cluster_id",
        "incident_id",
        "recommendation_id",
        "recommendation_incident_id",
        "namespace",
        "workload",
        "action_id",
        "params",
        "reversibility",
        "owner_kinds"
      ],
      "title": "OpaInput",
      "type": "object"
    },
    "OpaResult": {
      "additionalProperties": false,
      "properties": {
        "allow": {
          "title": "Allow",
          "type": "boolean"
        },
        "autonomy_level": {
          "const": "L0",
          "title": "Autonomy Level",
          "type": "string"
        },
        "bundle_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Bundle Hash",
          "type": "string"
        },
        "catalog_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Catalog Hash",
          "type": "string"
        },
        "execution_performed": {
          "const": false,
          "title": "Execution Performed",
          "type": "boolean"
        },
        "input_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "policy_version": {
          "const": "opa-l0-1",
          "title": "Policy Version",
          "type": "string"
        }
      },
      "required": [
        "policy_version",
        "bundle_hash",
        "catalog_hash",
        "input_hash",
        "allow",
        "autonomy_level",
        "execution_performed"
      ],
      "title": "OpaResult",
      "type": "object"
    },
    "PolicyReleaseBody": {
      "additionalProperties": false,
      "properties": {
        "bundle_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Bundle Hash",
          "type": "string"
        },
        "catalog_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Catalog Hash",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "format": {
          "const": "aegisops-local-policy-v1",
          "default": "aegisops-local-policy-v1",
          "title": "Format",
          "type": "string"
        },
        "issued_at": {
          "format": "date-time",
          "title": "Issued At",
          "type": "string"
        },
        "key_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Key Id",
          "type": "string"
        },
        "policy_version": {
          "const": "opa-l0-1",
          "default": "opa-l0-1",
          "title": "Policy Version",
          "type": "string"
        },
        "release_id": {
          "format": "uuid",
          "title": "Release Id",
          "type": "string"
        },
        "revision": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "release_id",
        "revision",
        "bundle_hash",
        "catalog_hash",
        "key_id",
        "issued_at",
        "expires_at"
      ],
      "title": "PolicyReleaseBody",
      "type": "object"
    },
    "PolicyReleaseCheck": {
      "additionalProperties": false,
      "properties": {
        "checked_at": {
          "format": "date-time",
          "title": "Checked At",
          "type": "string"
        },
        "release": {
          "anyOf": [
            {
              "$ref": "#/$defs/SignedPolicyRelease"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "state": {
          "anyOf": [
            {
              "$ref": "#/$defs/PolicyReleaseState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "enum": [
            "valid",
            "policy_missing",
            "policy_invalid",
            "policy_not_yet_valid",
            "policy_expired",
            "policy_revoked",
            "policy_rollback",
            "policy_mismatch"
          ],
          "title": "Status",
          "type": "string"
        },
        "trust": {
          "anyOf": [
            {
              "$ref": "#/$defs/TrustAnchor"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "checked_at",
        "status"
      ],
      "title": "PolicyReleaseCheck",
      "type": "object"
    },
    "PolicyReleaseState": {
      "additionalProperties": false,
      "properties": {
        "active_release_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Active Release Hash"
        },
        "changed_at": {
          "format": "date-time",
          "title": "Changed At",
          "type": "string"
        },
        "generation": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Generation",
          "type": "integer"
        },
        "minimum_revision": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Minimum Revision",
          "type": "integer"
        },
        "revoked_revisions": {
          "default": [],
          "items": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer"
          },
          "maxItems": 128,
          "title": "Revoked Revisions",
          "type": "array"
        }
      },
      "required": [
        "generation",
        "minimum_revision",
        "active_release_hash",
        "changed_at"
      ],
      "title": "PolicyReleaseState",
      "type": "object"
    },
    "SignedPolicyRelease": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "$ref": "#/$defs/PolicyReleaseBody"
        },
        "signature": {
          "pattern": "^[0-9a-f]{128}$",
          "title": "Signature",
          "type": "string"
        }
      },
      "required": [
        "body",
        "signature"
      ],
      "title": "SignedPolicyRelease",
      "type": "object"
    },
    "TrustAnchor": {
      "additionalProperties": false,
      "properties": {
        "key_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Key Id",
          "type": "string"
        },
        "public_key": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Public Key",
          "type": "string"
        }
      },
      "required": [
        "public_key",
        "key_id"
      ],
      "title": "TrustAnchor",
      "type": "object"
    }
  },
  "$id": "https://aegisops.invalid/schemas/v1/PepReceipt.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allowed_for_dry_run": {
      "title": "Allowed For Dry Run",
      "type": "boolean"
    },
    "bundle_valid": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bundle Valid"
    },
    "control_after": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuthorizationControl"
        },
        {
          "type": "null"
        }
      ]
    },
    "control_before": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuthorizationControl"
        },
        {
          "type": "null"
        }
      ]
    },
    "mode": {
      "default": "opa-dry-run-v1",
      "enum": [
        "opa-dry-run-v1",
        "opa-dry-run-v2"
      ],
      "title": "Mode",
      "type": "string"
    },
    "python_allowed": {
      "title": "Python Allowed",
      "type": "boolean"
    },
    "reason": {
      "enum": [
        "allowed",
        "python_denied",
        "control_invalid",
        "kill_switch",
        "control_changed",
        "opa_unavailable",
        "opa_invalid",
        "opa_denied",
        "policy_missing",
        "policy_invalid",
        "policy_not_yet_valid",
        "policy_expired",
        "policy_revoked",
        "policy_rollback",
        "policy_mismatch",
        "policy_changed",
        "policy_clock_rollback"
      ],
      "title": "Reason",
      "type": "string"
    },
    "release_after": {
      "anyOf": [
        {
          "$ref": "#/$defs/PolicyReleaseCheck"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "release_before": {
      "anyOf": [
        {
          "$ref": "#/$defs/PolicyReleaseCheck"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "request": {
      "$ref": "#/$defs/OpaInput"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/OpaResult"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "request",
    "python_allowed",
    "control_before",
    "control_after",
    "result",
    "allowed_for_dry_run",
    "reason"
  ],
  "title": "PepReceipt",
  "type": "object"
}
