{
  "$id": "https://aegisops.invalid/schemas/v1/RowDigest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "row_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Row Hash",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "row_hash"
  ],
  "title": "RowDigest",
  "type": "object"
}
