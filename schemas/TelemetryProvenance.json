{
  "$id": "https://aegisops.invalid/schemas/v1/TelemetryProvenance.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "batch_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Batch Hash",
      "type": "string"
    },
    "batch_id": {
      "format": "uuid",
      "title": "Batch Id",
      "type": "string"
    },
    "cluster_id": {
      "const": "kind-aegisops-demo",
      "default": "kind-aegisops-demo",
      "title": "Cluster Id",
      "type": "string"
    },
    "collector_id": {
      "const": "local-kind-reader",
      "default": "local-kind-reader",
      "title": "Collector Id",
      "type": "string"
    },
    "key_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Key Id",
      "type": "string"
    },
    "registration_id": {
      "format": "uuid",
      "title": "Registration Id",
      "type": "string"
    }
  },
  "required": [
    "batch_id",
    "batch_hash",
    "registration_id",
    "key_id"
  ],
  "title": "TelemetryProvenance",
  "type": "object"
}
