{
  "$defs": {
    "CauseCategory": {
      "enum": [
        "application_exit_nonzero",
        "missing_runtime_config",
        "invalid_command",
        "oom_killed",
        "unknown"
      ],
      "title": "CauseCategory",
      "type": "string"
    },
    "ComparisonStatus": {
      "enum": [
        "match",
        "mismatch",
        "abstained",
        "conflict",
        "unlabelled",
        "sample_incomplete"
      ],
      "title": "ComparisonStatus",
      "type": "string"
    },
    "IncidentOutcome": {
      "enum": [
        "resolved",
        "unresolved",
        "unknown"
      ],
      "title": "IncidentOutcome",
      "type": "string"
    },
    "PredictionKind": {
      "enum": [
        "fixture",
        "fallback",
        "model",
        "unclassified"
      ],
      "title": "PredictionKind",
      "type": "string"
    }
  },
  "$id": "https://aegisops.invalid/schemas/v1/QualityCase.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "confirmed_cause": {
      "anyOf": [
        {
          "$ref": "#/$defs/CauseCategory"
        },
        {
          "type": "null"
        }
      ]
    },
    "feedback_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Feedback Ids",
      "type": "array"
    },
    "incident_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Incident Id",
      "type": "string"
    },
    "incident_outcome": {
      "anyOf": [
        {
          "$ref": "#/$defs/IncidentOutcome"
        },
        {
          "type": "null"
        }
      ]
    },
    "model_name": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Model Name"
    },
    "predicted_categories": {
      "items": {
        "$ref": "#/$defs/CauseCategory"
      },
      "maxItems": 5,
      "title": "Predicted Categories",
      "type": "array"
    },
    "prediction_kind": {
      "$ref": "#/$defs/PredictionKind"
    },
    "provider": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Provider"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ComparisonStatus"
    }
  },
  "required": [
    "incident_id",
    "run_id",
    "feedback_ids",
    "confirmed_cause",
    "incident_outcome",
    "predicted_categories",
    "status",
    "prediction_kind",
    "provider",
    "model_name"
  ],
  "title": "QualityCase",
  "type": "object"
}
