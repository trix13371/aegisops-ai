{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "additionalProperties": {
            "anyOf": [
              {
                "maxLength": 512,
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "maxProperties": 16,
          "title": "Attributes",
          "type": "object"
        },
        "evidence_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/EvidenceSource"
        },
        "summary": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "source",
        "summary",
        "observed_at"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "EvidenceSource": {
      "enum": [
        "pod_status",
        "k8s_event",
        "container_log",
        "synthetic_fixture"
      ],
      "title": "EvidenceSource",
      "type": "string"
    },
    "IncidentType": {
      "enum": [
        "crash_loop_back_off"
      ],
      "title": "IncidentType",
      "type": "string"
    },
    "Origin": {
      "enum": [
        "synthetic_fixture",
        "local_kind"
      ],
      "title": "Origin",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "$id": "https://aegisops.invalid/schemas/v1/Incident.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cluster_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Cluster Id",
      "type": "string"
    },
    "container_name": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Container Name",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "incident_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Incident Id",
      "type": "string"
    },
    "incident_type": {
      "$ref": "#/$defs/IncidentType"
    },
    "namespace": {
      "const": "aegisops-demo",
      "title": "Namespace",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "origin": {
      "$ref": "#/$defs/Origin"
    },
    "pod_name": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Pod Name",
      "type": "string"
    },
    "severity": {
      "$ref": "#/$defs/Severity"
    },
    "workload_name": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Workload Name",
      "type": "string"
    }
  },
  "required": [
    "incident_id",
    "incident_type",
    "origin",
    "cluster_id",
    "namespace",
    "workload_name",
    "pod_name",
    "container_name",
    "severity",
    "observed_at",
    "evidence"
  ],
  "title": "Incident",
  "type": "object"
}
