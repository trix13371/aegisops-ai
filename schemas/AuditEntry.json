{
  "$defs": {
    "Origin": {
      "enum": [
        "synthetic_fixture",
        "local_kind"
      ],
      "title": "Origin",
      "type": "string"
    },
    "RunStatus": {
      "enum": [
        "completed",
        "failed",
        "blocked"
      ],
      "title": "RunStatus",
      "type": "string"
    }
  },
  "$id": "https://aegisops.invalid/schemas/v1/AuditEntry.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Completed At"
    },
    "incident_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Incident Id"
    },
    "model_name": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Model Name"
    },
    "origin": {
      "$ref": "#/$defs/Origin"
    },
    "policy_version": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Policy Version"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RunStatus"
    }
  },
  "required": [
    "run_id",
    "started_at",
    "completed_at",
    "status",
    "origin",
    "incident_id",
    "model_name",
    "policy_version"
  ],
  "title": "AuditEntry",
  "type": "object"
}
