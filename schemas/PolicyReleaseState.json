{
  "$id": "https://aegisops.invalid/schemas/v1/PolicyReleaseState.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "active_release_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Active Release Hash"
    },
    "changed_at": {
      "format": "date-time",
      "title": "Changed At",
      "type": "string"
    },
    "generation": {
      "maximum": 2147483647,
      "minimum": 1,
      "title": "Generation",
      "type": "integer"
    },
    "minimum_revision": {
      "maximum": 2147483647,
      "minimum": 1,
      "title": "Minimum Revision",
      "type": "integer"
    },
    "revoked_revisions": {
      "default": [],
      "items": {
        "maximum": 2147483647,
        "minimum": 1,
        "type": "integer"
      },
      "maxItems": 128,
      "title": "Revoked Revisions",
      "type": "array"
    }
  },
  "required": [
    "generation",
    "minimum_revision",
    "active_release_hash",
    "changed_at"
  ],
  "title": "PolicyReleaseState",
  "type": "object"
}
