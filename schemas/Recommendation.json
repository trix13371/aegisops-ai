{
  "$defs": {
    "ActionID": {
      "enum": [
        "escalate_to_human",
        "collect_more_evidence",
        "restart_workload",
        "rollback_deployment"
      ],
      "title": "ActionID",
      "type": "string"
    },
    "ActionProposal": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "$ref": "#/$defs/ActionID"
        },
        "params": {
          "additionalProperties": {
            "anyOf": [
              {
                "maxLength": 512,
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "maxProperties": 16,
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "action_id"
      ],
      "title": "ActionProposal",
      "type": "object"
    },
    "ReversibilityClass": {
      "enum": [
        "R1",
        "R2",
        "R3"
      ],
      "title": "ReversibilityClass",
      "type": "string"
    }
  },
  "$id": "https://aegisops.invalid/schemas/v1/Recommendation.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "diagnosis_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Diagnosis Id",
      "type": "string"
    },
    "execution_performed": {
      "const": false,
      "default": false,
      "title": "Execution Performed",
      "type": "boolean"
    },
    "explanation_steps": {
      "default": [],
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 16,
      "title": "Explanation Steps",
      "type": "array"
    },
    "incident_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Incident Id",
      "type": "string"
    },
    "proposed_action": {
      "$ref": "#/$defs/ActionProposal"
    },
    "rationale": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "recommendation_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Recommendation Id",
      "type": "string"
    },
    "requires_human_approval": {
      "const": true,
      "default": true,
      "title": "Requires Human Approval",
      "type": "boolean"
    },
    "reversibility_class": {
      "$ref": "#/$defs/ReversibilityClass"
    },
    "title": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "title",
    "rationale",
    "proposed_action",
    "recommendation_id",
    "incident_id",
    "diagnosis_id",
    "reversibility_class"
  ],
  "title": "Recommendation",
  "type": "object"
}
