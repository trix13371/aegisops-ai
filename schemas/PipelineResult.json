        "run_id",
        "started_at",
        "completed_at",
        "status",
        "origin"
      ],
      "title": "AuditRecord",
      "type": "object"
    },
    "AuthorizationControl": {
      "additionalProperties": false,
      "properties": {
        "blocked_actions": {
          "default": [],
          "items": {
            "enum": [
              "escalate_to_human",
              "collect_more_evidence",
              "restart_workload",
              "rollback_deployment"
            ],
            "type": "string"
          },
          "maxItems": 4,
          "title": "Blocked Actions",
          "type": "array"
        },
        "blocked_clusters": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Blocked Clusters",
          "type": "array"
        },
        "generation": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Generation",
          "type": "integer"
        },
        "global_blocked": {
          "title": "Global Blocked",
          "type": "boolean"
        }
      },
      "required": [
        "generation",
        "global_blocked"
      ],
      "title": "AuthorizationControl",
      "type": "object"
    },
    "AutonomyLevel": {
      "enum": [
        "L0"
      ],
      "title": "AutonomyLevel",
      "type": "string"
    },
    "BlockedCapability": {
      "enum": [
        "k8s_write",
        "shell_exec",
        "network_egress",
        "secret_read",
        "delete_data",
        "modify_policy_or_audit"
      ],
      "title": "BlockedCapability",
      "type": "string"
    },
    "CauseCategory": {
      "enum": [
        "application_exit_nonzero",
        "missing_runtime_config",
        "invalid_command",
        "oom_killed",
        "unknown"
      ],
      "title": "CauseCategory",
      "type": "string"
    },
    "Confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "ContextLimits": {
      "additionalProperties": false,
      "properties": {
        "max_events": {
          "default": 64,
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Max Events",
          "type": "integer"
        },
        "max_evidence": {
          "default": 32,
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Max Evidence",
          "type": "integer"
        },
        "max_log_bytes": {
          "default": 16384,
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Max Log Bytes",
          "type": "integer"
        },
        "max_log_lines": {
          "default": 100,
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Max Log Lines",
          "type": "integer"
        }
      },
      "title": "ContextLimits",
      "type": "object"
    },
    "Diagnosis": {
      "additionalProperties": false,
      "properties": {
        "diagnosis_id": {
          "maxLength": 128,
          "minLength": 1,
