          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/RunStatus"
        },
        "telemetry": {
          "anyOf": [
            {
              "$ref": "#/$defs/TelemetryProvenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
