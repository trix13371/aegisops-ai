        "errors": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AuditError"
          },
          "maxItems": 16,
          "title": "Errors",
          "type": "array"
        },
        "incident": {
          "anyOf": [
            {
              "$ref": "#/$defs/Incident"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "llm": {
          "anyOf": [
            {
              "$ref": "#/$defs/LLMMetadata"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "observation": {
          "anyOf": [
            {
              "$ref": "#/$defs/NoIncidentObservation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "pep_receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/PepReceipt"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "policy_decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/PolicyDecision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "recommendation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Recommendation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
