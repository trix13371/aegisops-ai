    "ActionID": {
      "enum": [
        "escalate_to_human",
        "collect_more_evidence",
        "restart_workload",
        "rollback_deployment"
      ],
      "title": "ActionID",
      "type": "string"
    },
    "ActionProposal": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "$ref": "#/$defs/ActionID"
        },
        "params": {
          "additionalProperties": {
            "anyOf": [
              {
                "maxLength": 512,
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "maxProperties": 16,
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "action_id"
      ],
      "title": "ActionProposal",
      "type": "object"
    },
    "AuditError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "AuditError",
      "type": "object"
    },
    "AuditRecord": {
      "additionalProperties": false,
      "properties": {
        "autonomy_level": {
          "$ref": "#/$defs/AutonomyLevel",
          "default": "L0"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "context": {
          "anyOf": [
            {
              "$ref": "#/$defs/DiagnosisContext"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "context_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context Hash"
        },
        "diagnosis": {
          "anyOf": [
            {
              "$ref": "#/$defs/Diagnosis"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "dry_run_result": {
          "anyOf": [
            {
              "$ref": "#/$defs/DryRunResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
