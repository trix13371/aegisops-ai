            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Missing Evidence",
          "type": "array"
        },
        "summary": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "diagnosis_id",
        "incident_id",
        "summary",
        "hypotheses"
      ],
      "title": "Diagnosis",
      "type": "object"
    },
    "DiagnosisContext": {
      "additionalProperties": false,
      "properties": {
        "context_hash": {
          "pattern": "^[0-9a-f]{64}$",
