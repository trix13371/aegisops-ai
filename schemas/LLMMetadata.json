{
  "$id": "https://aegisops.invalid/schemas/v1/LLMMetadata.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "input_tokens": {
      "default": 0,
      "maximum": 9223372036854775807,
      "minimum": 0,
      "title": "Input Tokens",
      "type": "integer"
    },
    "model_name": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Model Name",
      "type": "string"
    },
    "output_tokens": {
      "default": 0,
      "maximum": 9223372036854775807,
      "minimum": 0,
      "title": "Output Tokens",
      "type": "integer"
    },
    "parameters": {
      "additionalProperties": {
        "anyOf": [
          {
            "maxLength": 512,
            "type": "string"
          },
          {
            "type": "boolean"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "maxProperties": 16,
      "title": "Parameters",
      "type": "object"
    },
    "prompt_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Prompt Hash",
      "type": "string"
    },
    "prompt_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Prompt Id",
      "type": "string"
    },
    "provider": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    }
  },
  "required": [
    "provider",
    "model_name",
    "prompt_id",
    "prompt_hash"
  ],
  "title": "LLMMetadata",
  "type": "object"
}
